{
  "name": "omo-hustler",
  "version": "5.0.0-beta.51",
  "private": true,
  "description": "Private OpenCode-only Hustler package skeleton.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "workspaces": [
    "packages/rules-engine",
    "packages/delegate-core",
    "packages/mcp-stdio-core",
    "packages/mcp-client-core",
    "packages/lsp-core",
    "packages/utils",
    "packages/model-core",
    "packages/omo-config-core",
    "packages/prompts-core",
    "packages/comment-checker-core",
    "packages/hashline-core",
    "packages/tmux-core",
    "packages/team-core",
    "packages/openclaw-core",
    "packages/boulder-state",
    "packages/memory-core",
    "packages/telemetry-core",
    "packages/skills-loader-core",
    "packages/agents-md-core",
    "packages/shared-skills",
    "packages/lsp-tools-mcp",
    "packages/omo-opencode",
    "packages/hustler"
  ],
  "bin": {
    "hustler-opencode": "bin/hustler-opencode.js"
  },
  "files": [
    "LICENSE.md",
    "THIRD-PARTY-NOTICES.md",
    "dist",
    "bin/hustler-opencode.js",
    "assets/omo-hustler.schema.json",
    "packages/hustler/package.json",
    "packages/hustler/dist",
    "packages/lsp-tools-mcp/package.json",
    "packages/lsp-tools-mcp/dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./schema.json": "./dist/omo-hustler.schema.json"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "build:cli-node": "bun run script/build-cli-node.ts",
    "build:shared-skills-assets": "bun run script/copy-shared-skills-assets.ts",
    "build:lsp-tools-mcp": "npm --prefix packages/lsp-tools-mcp ci && npm --prefix packages/lsp-tools-mcp run build",
    "build:node-require-shim": "bun run script/patch-node-require-shim.ts",
    "build:all": "bun run build",
    "build:schema": "bun run script/build-schema.ts",
    "build:omo-schema": "bun run script/build-omo-schema.ts",
    "build:model-capabilities": "bun run script/build-model-capabilities.ts",
    "clean": "rm -rf dist",
    "prepack": "bun run build",
    "prepare": "bun run build",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsgo --noEmit && bun run typecheck:script && bun run typecheck:packages",
    "typecheck:packages": "tsgo --noEmit -p packages/omo-opencode/tsconfig.json && tsgo --noEmit -p packages/hustler/tsconfig.json",
    "typecheck:script": "tsgo --noEmit -p script/tsconfig.json",
    "test": "bun test --timeout 20000",
    "test:opencode": "bun test --timeout 20000 packages/omo-opencode"
  },
  "keywords": ["opencode", "plugin", "hustler"],
  "author": "YeonGyu-Kim",
  "license": "SUL-1.0",
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@code-yeongyu/comment-checker": "^0.8.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opencode-ai/plugin": "1.18.22",
    "@opencode-ai/sdk": "1.18.22",
    "@opentui/core": "^0.5.8",
    "@opentui/keymap": "^0.5.8",
    "@opentui/solid": "^0.5.8",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "js-yaml": "^5.0.0",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "posthog-node": "^5.51.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@omo-hustler/agents-md-core": "workspace:*",
    "@omo-hustler/boulder-state": "workspace:*",
    "@omo-hustler/comment-checker-core": "workspace:*",
    "@omo-hustler/delegate-core": "workspace:*",
    "@omo-hustler/hashline-core": "workspace:*",
    "@omo-hustler/hustler": "workspace:*",
    "@omo-hustler/lsp-core": "workspace:*",
    "@omo-hustler/mcp-client-core": "workspace:*",
    "@omo-hustler/mcp-stdio-core": "workspace:*",
    "@omo-hustler/memory-core": "workspace:*",
    "@omo-hustler/model-core": "workspace:*",
    "@omo-hustler/omo-config-core": "workspace:*",
    "@omo-hustler/omo-opencode": "workspace:*",
    "@omo-hustler/openclaw-core": "workspace:*",
    "@omo-hustler/prompts-core": "workspace:*",
    "@omo-hustler/rules-engine": "workspace:*",
    "@omo-hustler/shared-skills": "workspace:*",
    "@omo-hustler/skills-loader-core": "workspace:*",
    "@omo-hustler/team-core": "workspace:*",
    "@omo-hustler/telemetry-core": "workspace:*",
    "@omo-hustler/tmux-core": "workspace:*",
    "@omo-hustler/utils": "workspace:*",
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^4.0.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bun-types": "1.4.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "hono": "^4.12.18",
    "@hono/node-server": "^1.19.13",
    "express-rate-limit": "^8.5.1",
    "fast-uri": "^3.1.2",
    "path-to-regexp": "^8.4.2",
    "@types/node": "26.2.0"
  },
  "trustedDependencies": ["@code-yeongyu/comment-checker"]
}
